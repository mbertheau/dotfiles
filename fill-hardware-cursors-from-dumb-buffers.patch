+static bool cursor_buffer_write_texture(struct wlr_output_cursor *cursor,
+		struct wlr_buffer *buffer, const struct wlr_box *dst_box,
+		enum wl_output_transform transform) {
+	if (transform != WL_OUTPUT_TRANSFORM_NORMAL) {
+		return false;
+	}
+
+	void *data;
+	uint32_t format;
+	size_t stride;
+	if (!wlr_buffer_begin_data_ptr_access(buffer, WLR_BUFFER_DATA_PTR_ACCESS_WRITE,
+			&data, &format, &stride)) {
+		return false;
+	}
+
+	memset(data, 0, stride * (size_t)buffer->height);
+
+	struct wlr_box src = {0};
+	if (cursor->src_box.width > 0 && cursor->src_box.height > 0) {
+		src.x = (int)cursor->src_box.x;
+		src.y = (int)cursor->src_box.y;
+		src.width = (int)cursor->src_box.width;
+		src.height = (int)cursor->src_box.height;
+	}
+
+	uint32_t dst_x = dst_box->x < 0 ? 0 : (uint32_t)dst_box->x;
+	uint32_t dst_y = dst_box->y < 0 ? 0 : (uint32_t)dst_box->y;
+	bool ok = wlr_texture_read_pixels(cursor->texture, &(struct wlr_texture_read_pixels_options){
+		.data = data,
+		.format = format,
+		.stride = stride,
+		.dst_x = dst_x,
+		.dst_y = dst_y,
+		.src_box = src,
+	});
+	wlr_buffer_end_data_ptr_access(buffer);
+	return ok;
+}
