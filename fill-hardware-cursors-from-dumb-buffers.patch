+static struct wlr_allocator *output_get_cursor_allocator(struct wlr_output *output) {
+	if (output->cursor_allocator != NULL) {
+		return output->cursor_allocator;
+	}
+	if (output->cursor_allocator_checked) {
+		return output->allocator;
+	}
+	output->cursor_allocator_checked = true;
+	output->cursor_allocator = wlr_allocator_autocreate_drm_dumb(output->backend);
+	if (output->cursor_allocator != NULL) {
+		wlr_log(WLR_DEBUG, "Using DRM dumb buffers for hardware cursors on '%s'",
+			output->name);
+		return output->cursor_allocator;
+	}
+	return output->allocator;
+}
