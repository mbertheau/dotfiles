+struct wlr_allocator *wlr_allocator_autocreate_drm_dumb(struct wlr_backend *backend) {
+	int drm_fd = wlr_backend_get_drm_fd(backend);
+	if (drm_fd < 0) {
+		return NULL;
+	}
+
+	int dumb_fd = reopen_drm_node(drm_fd, false);
+	if (dumb_fd < 0) {
+		return NULL;
+	}
+
+	struct wlr_allocator *alloc = wlr_drm_dumb_allocator_create(dumb_fd);
+	if (alloc == NULL) {
+		close(dumb_fd);
+		return NULL;
+	}
+	return alloc;
+}
+
 struct wlr_allocator *wlr_allocator_autocreate(struct wlr_backend *backend,
 		struct wlr_renderer *renderer) {
 	uint32_t backend_caps = backend->buffer_caps;
