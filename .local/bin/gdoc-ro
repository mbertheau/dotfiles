#!/usr/bin/env python3
"""gdoc-ro - read-only Google Docs operations via gcloud creds."""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.parse

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from gdoc_common import DOCS_API, DRIVE_API, extract_id, get_token, http, run_cli  # noqa: E402


HELP_TEXT = """
gdoc-ro - read-only Google Docs access via gcloud creds (safe to auto-run)

Auth: by default `gcloud auth print-access-token --scopes=https://www.googleapis.com/auth/drive`.
Override with `GDOC_TOKEN=<token>` to skip the gcloud call.
DOC accepts a full URL or a bare document ID.

Commands:
  gdoc-ro help
  gdoc-ro info DOC                Drive metadata (name, owners, modifiedTime, ...)
  gdoc-ro read DOC                Full Docs API JSON (structured, with indices)
  gdoc-ro export DOC [--mime M]   Export via Drive. Default text/plain.
                                  Useful: text/plain, text/markdown, text/html, application/pdf
  gdoc-ro token                   Print the access token (e.g. `export GDOC_TOKEN=$(gdoc-ro token)`)

Examples:
  gdoc-ro info  https://docs.google.com/document/d/1Z4N.../edit
  gdoc-ro export 1Z4N... --mime text/markdown > doc.md
  gdoc-ro read 1Z4N... | jq '.body.content[-1].endIndex'   # last index, useful for inserts
"""


def get_doc(doc_id: str, token: str) -> dict:
    return http("GET", f"{DOCS_API}/{doc_id}", token=token)


def cmd_info(args: argparse.Namespace) -> None:
    token = get_token()
    doc_id = extract_id(args.doc)
    fields = "id,name,mimeType,modifiedTime,owners(emailAddress,displayName),webViewLink"
    info = http("GET", f"{DRIVE_API}/{doc_id}?fields={fields}", token=token)
    print(json.dumps(info, indent=2, ensure_ascii=False))


def cmd_read(args: argparse.Namespace) -> None:
    token = get_token()
    doc_id = extract_id(args.doc)
    print(json.dumps(get_doc(doc_id, token), indent=2, ensure_ascii=False))


def cmd_export(args: argparse.Namespace) -> None:
    token = get_token()
    doc_id = extract_id(args.doc)
    url = f"{DRIVE_API}/{doc_id}/export?mimeType={urllib.parse.quote(args.mime)}"
    sys.stdout.buffer.write(http("GET", url, token=token, raw=True))


def cmd_token(_: argparse.Namespace) -> None:
    print(get_token())


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="gdoc-ro", add_help=False)
    p.add_argument("-h", "--help", action="store_true")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("help")

    s = sub.add_parser("info"); s.add_argument("doc"); s.set_defaults(func=cmd_info)
    s = sub.add_parser("read"); s.add_argument("doc"); s.set_defaults(func=cmd_read)

    s = sub.add_parser("export")
    s.add_argument("doc")
    s.add_argument("--mime", default="text/plain")
    s.set_defaults(func=cmd_export)

    sub.add_parser("token").set_defaults(func=cmd_token)

    return p


if __name__ == "__main__":
    run_cli(build_parser(), HELP_TEXT, sys.argv[1:])
