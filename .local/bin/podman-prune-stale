#!/usr/bin/env python3
"""Remove podman containers idle for a week, then old unused images.

A container is idle when it is not running and the latest of its creation,
last start, and last exit is older than a week. Running containers stay.

Images have no last-used time. After stale containers are gone, unused images
created more than a week ago are removed. An image created within the week
stays, and so does any image a remaining container still uses.
"""

from __future__ import annotations

import json
import subprocess
import sys
import time

IDLE_SECONDS = 7 * 24 * 60 * 60
IMAGE_UNTIL = "168h"
ACTIVE_STATES = {"running", "paused", "restarting"}


def podman(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["podman", *args], check=True, text=True, capture_output=True)


def log(message: str) -> None:
    print(message, flush=True)


def stamp(unix_time: int) -> str:
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(unix_time)) if unix_time else "never"


def container_name(container: dict) -> str:
    return (container.get("Names") or [container["Id"][:12]])[0]


def last_used(container: dict) -> int:
    times = []
    for key in ("Created", "StartedAt", "ExitedAt"):
        value = container.get(key)
        if isinstance(value, (int, float)) and value > 0:
            times.append(int(value))
    return max(times) if times else 0


def main() -> None:
    dry_run = "--dry-run" in sys.argv[1:]
    cutoff = int(time.time()) - IDLE_SECONDS
    log(f"start dry_run={dry_run} cutoff={stamp(cutoff)} (idle more than a week)")
    listed = podman("ps", "-a", "--format", "json").stdout.strip()
    containers = json.loads(listed) if listed else []

    stale_ids: list[str] = []
    kept = 0
    for container in containers:
        name = container_name(container)
        state = container.get("State") or "unknown"
        used = last_used(container)
        if state in ACTIVE_STATES or used >= cutoff:
            reason = "running" if state in ACTIVE_STATES else "used within the week"
            log(f"keep container {name} state={state} last_used={stamp(used)} reason={reason}")
            kept += 1
            continue
        verb = "would remove" if dry_run else "remove"
        log(f"{verb} container {name} state={state} last_used={stamp(used)}")
        stale_ids.append(container["Id"])

    if stale_ids and not dry_run:
        podman("rm", *stale_ids)
    log(f"containers kept={kept} removed={len(stale_ids)}")

    if dry_run:
        log(f"would prune unused images created before {stamp(cutoff)}")
        return

    pruned = podman("image", "prune", "-a", "-f", "--filter", f"until={IMAGE_UNTIL}")
    if pruned.stderr.strip():
        print(pruned.stderr, file=sys.stderr, end="" if pruned.stderr.endswith("\n") else "\n")
    removed = [line for line in pruned.stdout.splitlines() if line.strip()]
    for image_id in removed:
        log(f"removed image {image_id}")
    log(f"images removed={len(removed)} (unused and created before {stamp(cutoff)})")


if __name__ == "__main__":
    main()
